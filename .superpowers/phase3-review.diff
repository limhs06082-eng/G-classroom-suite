+# 밀 때마다 도는 검사.
+#
+# 여기서 도는 것은 `npm run verify`와 **정확히 같다.** 두 벌로 적지 않는다 —
+# 갈라지면 "내 컴퓨터에서는 되는데" 하는 자리가 생기고, 그때 믿을 것이
+# 어느 쪽인지 알 수 없다.
+#
+# 설치 파일은 안 만든다. 그건 `release.yml`이 판 번호를 붙여 밀 때만 한다.
+# 여기서까지 만들면 밀 때마다 Rust를 빌드하느라 몇 분씩 걸린다.
+
+name: verify
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  verify:
+    # 웹 검사만 하므로 리눅스가 싸고 빠르다. 설치 파일은 windows에서 만든다.
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      # npm ci는 package-lock.json 그대로 받는다. install과 달리 잠금을
+      # 안 고치므로, 여기서 도는 것이 내 컴퓨터에서 도는 것과 같아진다.
+      - run: npm ci
+
+      - run: npm run verify
