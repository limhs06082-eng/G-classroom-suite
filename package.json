{
  "name": "classroom-suite",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "description": "우리 반 — 학급 운영 통합 앱",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vite build",
    "build:desktop": "cross-env VITE_TARGET=desktop vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-purity.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "verify": "npm run lint && npm run check:theme && npm run test && npm run build && npm run check:bundle web && npm run build:desktop && npm run check:bundle desktop",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@testing-library/user-event": "^14.6.5",
    "@types/qrcode": "^1.5.6",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.0"
  }
}
