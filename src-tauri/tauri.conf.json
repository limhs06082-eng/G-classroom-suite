{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-board",
  "mainBinaryName": "G-board",
  "version": "0.15.0",
  "identifier": "net.ssamdongne.gboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run check:release && npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "G-board",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5ODdDNTgzMERENzI2NjQKUldSa0p0Y05nOFdIdWJ4SzdDdTZuL0xMQUNQYkorVWxxMjFLaDJVRXp5dS9TM0F1RzJvTDNnYmoK",
      "endpoints": [
        "https://github.com/limhs06082-eng/G-classroom-suite/releases/latest/download/latest.json"
      ]
    }
  }
}
